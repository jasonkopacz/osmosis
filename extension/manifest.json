{
  "manifest_version": 3,
  "name": "Osmosis",
  "version": "3.0.0",
  "description": "Passively learn a language by replacing words on any page with translations.",
  "permissions": ["activeTab", "storage", "scripting", "identity"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["src/content/index.ts"] }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": { "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "externally_connectable": {
    "matches": ["https://osmosis-api.jtkopacz.workers.dev/*"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
